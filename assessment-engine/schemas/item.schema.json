{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaemenesacademy.org/assessment-engine/schemas/item.schema.json",
  "title": "Khaemenes Assessment Item",
  "type": "object",
  "required": [
    "id",
    "type",
    "prompt",
    "points",
    "domains"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "single-choice",
        "multi-select",
        "numeric",
        "short-response",
        "extended-response",
        "performance",
        "likert"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "correctAnswer": {},
    "tolerance": {
      "type": "number",
      "minimum": 0
    },
    "partialCredit": {
      "type": "boolean"
    },
    "points": {
      "type": "number",
      "minimum": 0
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "misconceptionTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interestTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "estimatedMinutes": {
      "type": "number",
      "minimum": 0
    },
    "adaptiveEligible": {
      "type": "boolean"
    },
    "formalAssessmentEligible": {
      "type": "boolean"
    },
    "exposureLimit": {
      "type": "integer",
      "minimum": 1
    },
    "rubricId": {
      "type": "string"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "single-choice"
          }
        }
      },
      "then": {
        "required": [
          "options",
          "correctAnswer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "multi-select"
          }
        }
      },
      "then": {
        "required": [
          "options",
          "correctAnswer"
        ],
        "properties": {
          "correctAnswer": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "numeric"
          }
        }
      },
      "then": {
        "required": [
          "correctAnswer"
        ]
      }
    }
  ],
  "additionalProperties": true
}
