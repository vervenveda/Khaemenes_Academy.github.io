{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaemenesacademy.org/assessment-engine/schemas/assessment.schema.json",
  "title": "Khaemenes Assessment Definition",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "mode",
    "settings",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "diagnostic",
        "practice",
        "quiz",
        "formal",
        "portfolio",
        "career",
        "survey",
        "performance"
      ]
    },
    "subject": {
      "type": "string"
    },
    "gradeBands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "delivery"
      ],
      "properties": {
        "delivery": {
          "enum": [
            "fixed",
            "adaptive"
          ]
        },
        "allowResume": {
          "type": "boolean"
        },
        "minItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "masteryThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "adaptivePolicy": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "minItems"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "minItems": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./item.schema.json"
      }
    }
  },
  "additionalProperties": true
}
